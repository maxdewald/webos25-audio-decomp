{
  "command": [
    "/opt/homebrew/opt/ghidra/libexec/support/analyzeHeadless",
    "build/ghidra/audio_a0_dsp1.main_60000000.bin",
    "audio_a0_dsp1.main_60000000.bin",
    "-process",
    "audio_a0_dsp1.main_60000000.bin",
    "-readOnly",
    "-noanalysis",
    "-scriptPath",
    "evidence/earc-dsp1",
    "-postScript",
    "EarcDsp1Export.java",
    "evidence/earc-dsp1",
    "-log",
    "evidence/earc-dsp1/ghidra.log",
    "-scriptlog",
    "evidence/earc-dsp1/script.log",
